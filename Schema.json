{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expert Trace Knowledge Record",
  "type": "object",
  "required": [
    "case_id",
    "source",
    "problem_context",
    "review_status",
    "limitations"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "session_id",
        "source_type"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "transcript",
            "document",
            "mixed"
          ]
        },
        "asset_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "problem_context": {
      "type": "object",
      "properties": {
        "problem_statement": {
          "type": [
            "string",
            "null"
          ]
        },
        "equipment_or_process": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "supported",
              "rejected",
              "unverified"
            ]
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradicting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "statement",
          "status"
        ]
      }
    },
    "options_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "option"
        ]
      }
    },
    "decision": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "agreed",
            "implemented",
            "validated",
            "superseded"
          ]
        },
        "rationale_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_ref",
          "evidence_type"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "start_time_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_time_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "page_or_slide": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "direct_quote",
              "transcript",
              "document",
              "measurement",
              "image",
              "expert_confirmation"
            ]
          }
        }
      }
    },
    "outcome_validation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "pending",
            "validated",
            "failed",
            "partial"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "reject",
              "request_evidence"
            ]
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ]
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "statement",
        "claim_type",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "observation",
            "fact",
            "hypothesis",
            "decision",
            "instruction",
            "outcome"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "unverified",
            "conflicting",
            "unknown"
          ]
        }
      }
    }
  }
}
